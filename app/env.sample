# Copy to .env.local. Never commit the real file.

# Optional RPC override. Defaults to the public Monad testnet endpoint.
MONAD_TESTNET_RPC=

# ---------------------------------------------------------------------------
# Cleanverse sandbox credentials — SERVER ONLY.
#
# CLEANVERSE_API_KEY is a Base64 AES key that decrypts every API response. It must
# never be prefixed NEXT_PUBLIC_, never be imported into a client component, and never
# be read anywhere except a route handler under src/app/api/.
#
# Cloudflare returns HTTP 403 "error code: 1010" to Python's default User-Agent before
# auth is even checked, so a browser-style UA is required on every outbound call.
# ---------------------------------------------------------------------------
CLEANVERSE_API_ID=
CLEANVERSE_API_KEY=
CLEANVERSE_BASE_URL=

# ---------------------------------------------------------------------------
# Demo wallet signers — SERVER ONLY, never prefix NEXT_PUBLIC_.
#
# These sign real Monad testnet transactions from throwaway demo wallets so a judge
# can watch a compliant buy settle and a non-compliant buy be refused, without
# holding an A-Pass themselves. Both wallets must be funded with testnet CWUSD and
# have approved ShareOffering — if the unverified wallet fails for want of funds the
# demo proves nothing, which /api/demo-buy reports honestly rather than hiding.
#
# Unset on a deployment = the buy panel is not rendered at all.
DEMO_VERIFIED_PRIVATE_KEY=
DEMO_UNVERIFIED_PRIVATE_KEY=
